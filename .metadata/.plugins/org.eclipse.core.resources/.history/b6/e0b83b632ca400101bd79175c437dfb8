package com.mediserve.pharmacyservice.controller;

import java.util.List;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.mediserve.pharmacyservice.entity.Medicines;
import com.mediserve.pharmacyservice.entity.Prescriptions;
import com.mediserve.pharmacyservice.service.PharmacyService;

@RestController
@RequestMapping("/pharmacy")
public class PharmacyController {
	
	 private final PharmacyService pharmacyService;

	    public PharmacyController(PharmacyService pharmacyService) {
	        this.pharmacyService = pharmacyService;
	    }

	    // Medicines
	    @PostMapping("/medicines")
	    public Medicines addMedicine(@RequestBody Medicines medicines) {
	        return pharmacyService.addMedicine(medicines);
	    }

	    @GetMapping("/medicines")
	    public List<Medicines> getAllMedicines() {
	        return pharmacyService.getAllMedicines();
	    }

	    // Prescriptions
	    @PostMapping("/prescriptions")
	    public Prescriptions addPrescription(@RequestBody Prescriptions prescriptions) {
	        return pharmacyService.addPrescription(prescriptions);
	    }

	    @GetMapping("/prescriptions")
	    public List<Prescriptions> getAllPrescriptions() {
	        return pharmacyService.getAllPrescriptions();
	    }

	    @GetMapping("/prescriptions/patient/{patientId}")
	    public List<Prescriptions> getPrescriptionsByPatient(@PathVariable Integer patientId) {
	        return pharmacyService.getPrescriptionsByPatient(patientId);
	    }

	    @GetMapping("/prescriptions/doctor/{doctorId}")
	    public List<Prescriptions> getPrescriptionsByDoctor(@PathVariable Integer doctorId) {
	        return pharmacyService.getPrescriptionsByDoctor(doctorId);
	    }
}
